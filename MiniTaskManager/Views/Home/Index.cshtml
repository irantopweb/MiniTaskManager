@model DashboardViewModel
@{
    ViewData["Title"] = "داشبورد";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h1 class="h3 mb-1">داشبورد</h1>
        <p class="text-muted mb-0">نمای کلی وضعیت پروژه‌ها و وظایف</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Projects" asp-action="Create" class="btn btn-outline-primary">
            <i class="bi bi-folder-plus"></i> پروژه جدید
        </a>
        <a asp-controller="Tasks" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> وظیفه جدید
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-xl-2">
        <a asp-controller="Projects" asp-action="Index" class="text-decoration-none">
            <div class="card shadow-sm h-100 stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="stat-icon bg-primary-subtle text-primary"><i class="bi bi-folder2"></i></span>
                    <div>
                        <div class="fs-4 fw-bold text-body">@Model.TotalProjects</div>
                        <div class="text-muted small">کل پروژه‌ها</div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-6 col-md-4 col-xl-2">
        <a asp-controller="Tasks" asp-action="Index" class="text-decoration-none">
            <div class="card shadow-sm h-100 stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="stat-icon bg-dark-subtle text-dark"><i class="bi bi-list-check"></i></span>
                    <div>
                        <div class="fs-4 fw-bold text-body">@Model.TotalTasks</div>
                        <div class="text-muted small">کل وظایف</div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-6 col-md-4 col-xl-2">
        <a asp-controller="Tasks" asp-action="Index" asp-route-status="Todo" class="text-decoration-none">
            <div class="card shadow-sm h-100 stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="stat-icon bg-secondary-subtle text-secondary-emphasis"><i class="bi bi-hourglass-split"></i></span>
                    <div>
                        <div class="fs-4 fw-bold text-body">@Model.TodoCount</div>
                        <div class="text-muted small">در انتظار انجام</div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-6 col-md-4 col-xl-2">
        <a asp-controller="Tasks" asp-action="Index" asp-route-status="InProgress" class="text-decoration-none">
            <div class="card shadow-sm h-100 stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="stat-icon bg-warning-subtle text-warning-emphasis"><i class="bi bi-arrow-repeat"></i></span>
                    <div>
                        <div class="fs-4 fw-bold text-body">@Model.InProgressCount</div>
                        <div class="text-muted small">در حال انجام</div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-6 col-md-4 col-xl-2">
        <a asp-controller="Tasks" asp-action="Index" asp-route-status="Done" class="text-decoration-none">
            <div class="card shadow-sm h-100 stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="stat-icon bg-success-subtle text-success-emphasis"><i class="bi bi-check-circle"></i></span>
                    <div>
                        <div class="fs-4 fw-bold text-body">@Model.DoneCount</div>
                        <div class="text-muted small">انجام شده</div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-6 col-md-4 col-xl-2">
        <a asp-controller="Tasks" asp-action="Index" asp-route-sortBy="dueDate" asp-route-sortDescending="false" class="text-decoration-none">
            <div class="card shadow-sm h-100 stat-card">
                <div class="card-body d-flex align-items-center gap-3">
                    <span class="stat-icon bg-danger-subtle text-danger-emphasis"><i class="bi bi-exclamation-triangle"></i></span>
                    <div>
                        <div class="fs-4 fw-bold text-danger">@Model.OverdueCount</div>
                        <div class="text-muted small">عقب‌افتاده</div>
                    </div>
                </div>
            </div>
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h2 class="h5 mb-0"><i class="bi bi-clock-history"></i> آخرین وظایف ثبت‌شده</h2>
        <a asp-controller="Tasks" asp-action="Index" class="btn btn-sm btn-outline-primary">مشاهده همه وظایف</a>
    </div>
    <partial name="_TaskTable" model='new TaskTableViewModel { Items = Model.RecentTasks, EmptyMessage = "هنوز وظیفه‌ای ثبت نشده است." }' />
</div>
