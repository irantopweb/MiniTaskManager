@model ErrorViewModel
@{
    ViewData["Title"] = "خطا";
}

<div class="text-center py-5">
    <div class="display-3 mb-3">
        @if (Model.StatusCode == 404)
        {
            <i class="bi bi-compass text-warning"></i>
        }
        else
        {
            <i class="bi bi-bug text-danger"></i>
        }
    </div>
    <h1 class="h3">@Model.Headline</h1>
    <p class="text-muted">@Model.Description</p>
    @if (Model.ShowRequestId)
    {
        <p class="text-muted small">شناسه خطا: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">
        <i class="bi bi-house"></i> بازگشت به داشبورد
    </a>
</div>
