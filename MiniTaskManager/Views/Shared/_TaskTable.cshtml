@model TaskTableViewModel
@if (Model.Items.Count == 0)
{
    <div class="p-3">
        <div class="alert alert-info mb-0 text-center">@Model.EmptyMessage</div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>عنوان</th>
                    @if (Model.ShowProject)
                    {
                        <th>پروژه</th>
                    }
                    <th>
                        @if (Model.Filter is null)
                        {
                            @:اولویت
                        }
                        else
                        {
                            <a class="text-decoration-none fw-semibold text-dark" href='@SortUrl("priority")'>اولویت@SortIndicator("priority")</a>
                        }
                    </th>
                    <th>وضعیت</th>
                    <th>
                        @if (Model.Filter is null)
                        {
                            @:سررسید
                        }
                        else
                        {
                            <a class="text-decoration-none fw-semibold text-dark" href='@SortUrl("dueDate")'>سررسید@SortIndicator("dueDate")</a>
                        }
                    </th>
                    <th>
                        @if (Model.Filter is null)
                        {
                            @:تاریخ ایجاد
                        }
                        else
                        {
                            <a class="text-decoration-none fw-semibold text-dark" href='@SortUrl("createdAt")'>تاریخ ایجاد@SortIndicator("createdAt")</a>
                        }
                    </th>
                    <th class="text-end">عملیات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var task in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">
                            <a asp-controller="Tasks" asp-action="Details" asp-route-id="@task.Id" class="text-decoration-none">@task.Title</a>
                        </td>
                        @if (Model.ShowProject)
                        {
                            <td>
                                <a asp-controller="Projects" asp-action="Details" asp-route-id="@task.ProjectId" class="text-decoration-none text-muted">@task.ProjectTitle</a>
                            </td>
                        }
                        <td><span class="badge rounded-pill @task.Priority.GetBadgeClass()">@task.Priority.GetDisplayName()</span></td>
                        <td><span class="badge rounded-pill @task.Status.GetBadgeClass()">@task.Status.GetDisplayName()</span></td>
                        <td>
                            @if (task.DueDate is { } dueDate)
                            {
                                <span class="@(task.IsOverdue ? "text-danger fw-semibold" : "")">@dueDate.ToString("yyyy/MM/dd")</span>
                                if (task.IsOverdue)
                                {
                                    <span class="badge bg-danger ms-1">عقب‌افتاده</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-muted">@task.CreatedAt.ToString("yyyy/MM/dd")</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm" role="group">
                                <a asp-controller="Tasks" asp-action="Details" asp-route-id="@task.Id" class="btn btn-outline-secondary" title="جزئیات"><i class="bi bi-eye"></i></a>
                                <a asp-controller="Tasks" asp-action="Edit" asp-route-id="@task.Id" class="btn btn-outline-warning" title="ویرایش"><i class="bi bi-pencil"></i></a>
                                <a asp-controller="Tasks" asp-action="Delete" asp-route-id="@task.Id" class="btn btn-outline-danger" title="حذف"><i class="bi bi-trash"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@functions {
    private string SortUrl(string sortBy)
    {
        var filter = Model.Filter!;
        var isCurrent = string.Equals(filter.SortBy, sortBy, StringComparison.OrdinalIgnoreCase);
        var nextDescending = isCurrent ? !filter.SortDescending : (sortBy != "dueDate");

        return Url.Action("Index", "Tasks", new
        {
            search = filter.Search,
            projectId = filter.ProjectId,
            status = filter.Status,
            priority = filter.Priority,
            sortBy,
            sortDescending = nextDescending
        }) ?? "#";
    }

    private string SortIndicator(string sortBy)
    {
        if (!string.Equals(Model.Filter!.SortBy, sortBy, StringComparison.OrdinalIgnoreCase))
        {
            return string.Empty;
        }

        return Model.Filter.SortDescending ? " ▼" : " ▲";
    }
}
