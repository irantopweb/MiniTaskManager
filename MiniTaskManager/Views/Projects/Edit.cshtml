@model ProjectFormViewModel
@{
    ViewData["Title"] = "ویرایش پروژه";
}

<h1 class="h3 mb-4">ویرایش پروژه</h1>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <partial name="_ProjectForm" model="Model" />
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> ذخیره تغییرات</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">انصراف</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
