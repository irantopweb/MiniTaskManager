@model ProjectListItemViewModel
@{
    ViewData["Title"] = "حذف پروژه";
}

<h1 class="h3 mb-4 text-danger">حذف پروژه</h1>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="alert alert-warning mb-3">
            <i class="bi bi-exclamation-triangle"></i>
            آیا از حذف پروژه «<strong>@Model.Title</strong>» مطمئن هستید؟
        </div>
        <p>
            با حذف این پروژه، <strong>@Model.TaskCount</strong> وظیفه مرتبط با آن نیز حذف خواهد شد. این عملیات قابل بازگشت نیست.
        </p>
        <dl class="row small">
            <dt class="col-sm-3 text-muted">تاریخ ایجاد</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy/MM/dd")</dd>
        </dl>
        <form asp-action="Delete" method="post" onsubmit="return confirm('پس از حذف امکان بازگردانی وجود ندارد. مطمئن هستید؟');">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> حذف قطعی</button>
                <a asp-action="Index" class="btn btn-outline-secondary">انصراف</a>
            </div>
        </form>
    </div>
</div>
